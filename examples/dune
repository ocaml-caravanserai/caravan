; The examples of README.md, each copied to a module and compiled. The examples
; of the directories examples/*/ have their own dune files.

(executable
 (name readme)
 (modules readme)
 (libraries caravan weft weft.os))

; The first OCaml example of README.md. The rule copies it to readme.ml, so the
; build fails if this example of the README does not compile. section.awk
; fails if README.md has no OCaml example.

(rule
 (action
  (with-stdout-to
   readme.ml
   (run awk -v "section=" -f %{dep:section.awk} %{dep:../README.md}))))

; The example of the Testing section of README.md, as readme_testing.ml.

(executable
