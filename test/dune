; The suites of caravan. They run in the simulator of weft. The deps give the
; source scan of test_core the files of the libraries.

(tests
 (names
  test_core
  test_tcp
  test_h1
  test_h1_server
  test_conformance
  test_net
  test_server
  test_server_stateful
  test_client
  test_websocket
  test_testing
  test_router
  test_middleware
  test_static)
 (modules
  test_core
  test_tcp
  test_h1
  test_h1_server
  test_conformance
  test_net
  test_server
  test_server_stateful
  test_client
  test_websocket
  test_testing
  test_router
  test_middleware
  test_static
  memory_server
  wire
  conformance_app)
 (libraries
  caravan
  caravan.client
  caravan.websocket
  caravan.testing
  caravan.router
  caravan.middleware
  caravan.static
  server_support
  sim_support
  weft
  weft.flow
  weft.sim
  windtrap
  http-date
  numeric_hosts
  ; test_net puts the standard error on a broken pipe for one test
  ; (with_broken_stderr). No fiber code of the suites calls Unix.
  unix)
 (deps
  (glob_files ../src/*.ml)
  (glob_files ../client/*.ml)
  (glob_files ../websocket/*.ml)
  (glob_files ../testing/*.ml)
  (glob_files ../router/*.ml)
  (glob_files ../middleware/*.ml)
  (glob_files ../static/*.ml)
  (glob_files ../tls/*.ml)
  (glob_files ../session/*.ml)
  (glob_files ../auth/*.ml)
  (glob_files ../compress/*.ml)
  (glob_files ../jobs/*.ml)
  (glob_files ../html/*.ml)
  (glob_files ../http2/*.ml)))

; The hosts of the numeric tests of Resolver, shared by test_client and
; test_numeric_unix.

(library
 (name numeric_hosts)
 (modules numeric_hosts))

; The numeric parser of Resolver against inet_pton, through
; Unix.inet_addr_of_string. It is a suite of its own, so that the suites on the
; simulator do not call this parser of Unix. It runs only on Linux: the
; inet_pton of glibc refuses a 0 before a digit in an IPv4 part, as Resolver
; does (RFC 3986 dec-octet), but that of macOS accepts 01.2.3.4 (CI, 2026-11).

(test
 (name test_numeric_unix)
 (modules test_numeric_unix)
 (enabled_if
  (= %{system} linux))
 (libraries caravan.client numeric_hosts windtrap unix))

; The helpers of the caravan tests on the simulator: the core helpers and the
; server helpers.

(library
 (name server_support)
 (modules server_support)
 (libraries caravan weft weft.sim sim_support windtrap))

; The harness of the simulator. It has no dependency on caravan.

(library
 (name sim_support)
 (modules sim_support)
 (libraries weft weft.sim))

; The tests of the harness. This suite reaches no mutant of caravan.

(test
 (name test_sim_support)
 (modules test_sim_support)
 (libraries sim_support windtrap unix))

; The printers of caravan.testing for the exceptions of Weft_sim. The other
; suites link sim_support, whose printers have the same format and come first,
; thus this suite links caravan.testing and no harness.

(test
 (name test_printers)
 (modules test_printers)
 (libraries caravan.testing weft.sim windtrap))

; The test certificates of caravan.tls, for test_tls and test_linux.

(library
 (name tls_support)
 (modules tls_support)
 (libraries tls x509 domain-name ipaddr mirage-crypto-ec ptime))

